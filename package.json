{
  "name": "assessorarafaela",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Site Rafaela Alves — Assessora de Investimentos (EQI). HTML + CSS + TypeScript em Cloudflare Workers.",
  "scripts": {
    "build": "tsx scripts/build.ts",
    "dev": "npm run build && wrangler dev",
    "preview": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "typecheck": "wrangler types && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json",
    "check": "tsx scripts/check.ts",
    "images": "tsx scripts/optimize-images.ts",
    "fonts": "tsx scripts/build-fonts.ts",
    "import:wp": "tsx scripts/import-wp.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261119.1",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@types/fontkit": "^2.0.9",
    "@types/html-minifier-terser": "^7.0.2",
    "@types/node": "^26.6.6",
    "cheerio": "^1.2.0",
    "esbuild": "^0.28.2",
    "fontkit": "^3.0.0",
    "html-minifier-terser": "^7.2.0",
    "lightningcss": "^1.33.0",
    "lucide-static": "^1.76.0",
    "sharp": "^0.35.5",
    "subset-font": "^2.9.0",
    "svgo": "^4.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "wrangler": "^4.165.0"
  }
}
